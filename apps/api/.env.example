# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:3000
# Set to 1 in production when the API is reachable only through a trusted proxy.
# Leave unset for direct local development so forwarded headers are ignored.
# TRUST_PROXY=1

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=scoutlgs
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Auth service
AUTH_JWKS_URL=http://localhost:5002/auth/internal/.well-known/jwks.json
AUTH_JWT_ISSUER=scoutlgs-auth
AUTH_JWT_AUDIENCE=scoutlgs-api

# Optional approved server-to-server Moxfield importer. Leave both unset to disable
# only Moxfield link imports; the other providers and paste import still work.
# MOXFIELD_IMPORT_ENDPOINT=https://provider-approved.example/decks
# MOXFIELD_IMPORT_CREDENTIAL=Bearer replace-with-approved-credential
